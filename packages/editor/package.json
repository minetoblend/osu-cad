{
  "name": "@osucad/editor",
  "version": "1.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/minetoblend/osu-cad.git",
    "directory": "packages/editor"
  },
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./editor": {
      "source": "./src/Editor.ts",
      "types": "./dist/Editor.d.ts",
      "import": "./dist/Editor.js",
      "default": "./dist/Editor.js"
    },
    "./runtime": {
      "source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@osucad/core": "1.1.2",
    "@osucad/framework": "1.1.2",
    "@osucad/multiplayer-core": "workspace:^",
    "@osucad/multiplayer-client": "workspace:^",
    "@osucad/multiplayer-protocol": "workspace:^",
    "eventemitter3": "^5.0.1",
    "pixi.js": "^8.12.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
