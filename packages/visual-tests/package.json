{
  "name": "@osucad/visual-tests",
  "version": "1.1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/minetoblend/osu-cad.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "dist/rulesets/scoring/EmptyHitWindows.*"
  ],
  "exports": {
