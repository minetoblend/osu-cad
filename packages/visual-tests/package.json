      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@osucad/framework": "1.1.2",
    "pixi.js": "^8.13.1"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
