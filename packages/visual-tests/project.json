{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@osucad/visual-tests",
  "targets": {
    "build": {
      "executor": "@osucad/nx:vite-tsgo",
      "cache": true,
      "inputs": [
        "production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "packages/visual-tests/dist",
        "tsConfig": "packages/visual-tests/tsconfig.lib.json",
        "rootDir": "packages/visual-tests/src",
        "generatePackageJson": false
      }
    }
  }
}
