{
  "name": "@osucad/ruleset-osu",
  "version": "1.1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/minetoblend/osu-cad.git",
    "directory": "packages/ruleset-osu"
  },
  "sideEffects": [
    "./dist/init.*"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./init": {
      "source": "./src/init.ts",
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js",
      "default": "./dist/init.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "pixi.js": "^8.13.1",
    "@osucad/core": "workspace:^",
    "@osucad/framework": "workspace:^",
    "@osucad/editor": "workspace:^",
    "@osucad/multiplayer-core": "workspace:^"
  },
  "devDependencies": {
    "@osucad/visual-tests": "workspace:^"
  }
}
