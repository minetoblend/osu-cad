{
  "name": "@osucad/framework",
  "version": "1.1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/minetoblend/osu-cad.git",
    "directory": "packages/framework"
  },
  "sideEffects": [
    "./dist/reactivity/init.*",
    "./dist/reactivity/DrawableMixin.*",
    "./dist/TextureMixins.*",
    "./dist/textures.*",
    "./dist/renderers/init.*",
    "./dist/init.*"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./init": {
      "source": "./src/init.ts",
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js",
      "default": "./dist/init.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@vue/reactivity": "^3.5.13",
    "debug": "^4.4.1",
    "diff": "^7.0.0",
    "eventemitter3": "^5.0.1",
    "pixi-filters": "^6.1.2",
    "pixi.js": "^8.12.0",
    "unzipit": "^1.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/diff": "^7.0.2",
    "vite-plugin-conditional-compiler": "^0.3.1"
  }
}
