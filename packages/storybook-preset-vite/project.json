{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@osucad/storybook-preset-vite",
  "namedInputs": {
    "production": [
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": ["^build"],
      "options": {
        "command": "npx tsup",
        "cwd": "packages/storybook-preset-vite"
      }
    }
  }
}