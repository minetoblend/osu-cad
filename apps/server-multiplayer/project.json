{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@osucad/server-multiplayer",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "apps/server-multiplayer/dist",
        "format": [
          "esm"
        ],
        "bundle": true,
        "main": "apps/server-multiplayer/src/main.ts",
        "tsConfig": "apps/server-multiplayer/tsconfig.app.json",
        "assets": [
          "apps/server-multiplayer/src/assets"
        ],
        "declaration": false,
        "external": [
          "@osucad/*"
        ],
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "@osucad/server-multiplayer:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "@osucad/server-multiplayer:build:development"
        },
        "production": {
          "buildTarget": "@osucad/server-multiplayer:build:production"
        }
      }
    }
  }
}