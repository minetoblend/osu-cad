{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "targets": {
    "full-stack": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "nx run editor-web:serve",
          "nx run server-multiplayer:serve"
        ],
        "parallel": true
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "find ./packages/*/dist -delete || true",
          "find ./multiplayer/*/dist -delete || true"
        ]
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    }
  }
}
